[General]
ColorScheme=${color_scheme}
Name=${theme_name}
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground=${bg_header_rgb}
activeBlend=${fg_primary_rgb}
activeForeground=${fg_primary_rgb}
inactiveBackground=${bg_window_rgb}
inactiveBlend=${fg_tertiary_rgb}
inactiveForeground=${fg_tertiary_rgb}
