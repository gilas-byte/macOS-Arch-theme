# ${theme_name} — gerado pelo tooling a partir do palette.toml. Não editar à mão.
[ColorEffects:Disabled]
Color=${bg_window_rgb}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=${bg_window_rgb}
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=${bg_elevated_rgb}
BackgroundNormal=${bg_control_rgb}
DecorationFocus=${accent_primary_rgb}
DecorationHover=${accent_primary_rgb}
ForegroundActive=${accent_primary_rgb}
ForegroundInactive=${fg_secondary_rgb}
ForegroundLink=${accent_primary_rgb}
ForegroundNegative=${sem_red_rgb}
ForegroundNeutral=${sem_orange_rgb}
ForegroundNormal=${fg_primary_rgb}
ForegroundPositive=${sem_green_rgb}
ForegroundVisited=${sem_purple_rgb}

[Colors:Complementary]
